{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sinal do radar Raiz",
  "description": "Um sinal por item; cada <lente>.json da rodada é um array deles. Validado por scripts/checar_radar.sh (jq).",
  "type": "object",
  "required": [
    "id",
    "lente",
    "titulo",
    "fato",
    "por_que_sinal",
    "url",
    "data_publicacao",
    "tipo",
    "confianca"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(CON|FRO|ADJ|UIX)-[0-9]{2,}$"
    },
    "lente": {
      "enum": [
        "consolidado",
        "fronteira",
        "adjacente",
        "ui-ux"
      ]
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "fato": {
      "type": "string",
      "minLength": 1
    },
    "por_que_sinal": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "data_publicacao": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$"
    },
    "tipo": {
      "enum": [
        "produto",
        "paper",
        "tese",
        "reclamacao",
        "analogia",
        "regulacao",
        "padrao-ui"
      ]
    },
    "confianca": {
      "enum": [
        "alta",
        "media",
        "baixa"
      ]
    }
  }
}
